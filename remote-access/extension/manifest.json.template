{
  "manifest_version": 3,
  "name": "InfraSight 원격 접속",
  "version": "1.0",
  "description": "InfraSight에서 SSH/Telnet 버튼 클릭으로 PuTTY를 실행합니다.",
  "key": "",
  "background": {
    "service_worker": "background.js"
  },
  "externally_connectable": {
    "matches": [
      "https://localhost:8443/*",
      "https://__LAN_IP__:8443/*"
    ]
  },
  "permissions": ["nativeMessaging"]
}
